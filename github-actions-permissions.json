{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ECRAuthentication",
        "Effect": "Allow",
        "Action": [
          "ecr:GetAuthorizationToken"
        ],
        "Resource": "*"
      },
      {
        "Sid": "ECRPushOperatorImage",
        "Effect": "Allow",
        "Action": [
          "ecr:BatchCheckLayerAvailability",
          "ecr:GetDownloadUrlForLayer",
          "ecr:BatchGetImage",
          "ecr:InitiateLayerUpload",
          "ecr:UploadLayerPart",
          "ecr:CompleteLayerUpload",
          "ecr:PutImage"
        ],
        "Resource": "arn:aws:ecr:us-east-2:752192503262:repository/snowflake-operator"
      },
      {
        "Sid": "EKSDescribeCluster",
        "Effect": "Allow",
        "Action": [
          "eks:DescribeCluster"
        ],
        "Resource": "arn:aws:eks:us-east-2:752192503262:cluster/snowflake-operator-cluster"
      }
    ]
  }